# Right-anchored panel: status modules, clock, systray — shrinks to content.

#-------------------------------------
# Backgrounds
#-------------------------------------

# 1: transparent
rounded = 0
border_width = 0
border_color = #000000 0
background_color = #000000 0

# 2: panel
rounded = 0
border_width = 2
border_sides = TB
border_color = #555555 100
background_color = #111111 100

# 3: snapshot
rounded = 0
border_width = 2
border_sides = TL
border_color = #bd3232 100
background_color = #8b0000 100

# 4: spotify
rounded = 0
border_width = 2
border_sides = TL
border_color = #4e5a65 100
background_color = #1c2833 100

# 5: disk
rounded = 0
border_width = 2
border_sides = TL
border_color = #aa7444 100
background_color = #784212 100

# 6: cpu
rounded = 0
border_width = 2
border_sides = TL
border_color = #4c55b0 100
background_color = #1a237e 100

# 7: memory
rounded = 0
border_width = 2
border_sides = TL
border_color = #7c558c 100
background_color = #4a235a 100

# 8: volume
rounded = 0
border_width = 2
border_sides = TL
border_color = #3232dc 100
background_color = #0000aa 100

# 9: weather
rounded = 0
border_width = 2
border_sides = TL
border_color = #4d9052 100
background_color = #1b5e20 100

# 10: date
rounded = 0
border_width = 2
border_sides = TL
border_color = #ad6a32 100
background_color = #7b3800 100

# 11: time/clock
rounded = 0
border_width = 2
border_sides = TL
border_color = #329296 100
background_color = #006064 100

# 12: disk-storage
rounded = 0
border_width = 2
border_sides = TL
border_color = #546e7a 100
background_color = #37474f 100

#-------------------------------------
# Panel
#-------------------------------------
panel_items = E1E2E3E4E5E6E7SC
panel_size = 1% 24
panel_margin = 0 0
panel_padding = 0 2 2
panel_dock = 0
panel_layer = bottom
panel_position = bottom right horizontal
panel_monitor = all
wm_menu = 0
panel_background_id = 2
panel_shrink = 1

#-------------------------------------
# System Tray
#-------------------------------------
systray_padding = 0 3 4
systray_background_id = 1
systray_sort = ascending
systray_icon_size = 16
systray_icon_asb = 100 0 0
systray_monitor = primary

#-------------------------------------
# Clock (time)
#-------------------------------------
time1_format = %I:%M %p
time1_font = JetBrainsMono Nerd Font Mono 10
time2_format =
clock_font_color = #ffffff 100
clock_padding = 6 2
clock_background_id = 11
clock_lclick_command =
clock_rclick_command =

#-------------------------------------
# Executor 1 — BTRFS snapshot indicator
#-------------------------------------
execp = new
execp_command = ~/.config/tint2/scripts/snapshot.sh
execp_interval = 60
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #ffffff 100
execp_padding = 4 2
execp_background_id = 3
execp_centered = 1

#-------------------------------------
# Executor 2 — Spotify now playing
#-------------------------------------
execp = new
execp_command = ~/.config/tint2/scripts/spotify.sh
execp_interval = 5
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #81b71a 100
execp_padding = 4 2
execp_background_id = 4
execp_centered = 1
execp_lclick_command = playerctl --player=spotify play-pause

#-------------------------------------
# Executor 3 — Disk / (root)
#-------------------------------------
execp = new
execp_command = ~/.config/tint2/scripts/disk-root.sh
execp_interval = 30
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #ffffff 100
execp_padding = 4 2
execp_background_id = 5
execp_centered = 1

#-------------------------------------
# Executor 4 — Disk /mnt/storage
#-------------------------------------
execp = new
execp_command = ~/.config/tint2/scripts/disk-storage.sh
execp_interval = 30
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #ffffff 100
execp_padding = 4 2
execp_background_id = 12
execp_centered = 1

#-------------------------------------
# Executor 5 — Volume
#-------------------------------------
execp = new
execp_command = ~/.config/tint2/scripts/volume.sh
execp_interval = 5
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #ffffff 100
execp_padding = 4 2
execp_background_id = 8
execp_centered = 1
execp_lclick_command = pactl set-sink-mute @DEFAULT_SINK@ toggle
execp_rclick_command = pavucontrol &
execp_uwheel_command = pactl set-sink-volume @DEFAULT_SINK@ +5%
execp_dwheel_command = pactl set-sink-volume @DEFAULT_SINK@ -5%

#-------------------------------------
# Executor 7 — Weather
#-------------------------------------
execp = new
execp_command = ~/.config/i3blocks/scripts/wttr
execp_interval = 1800
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #ffffff 100
execp_padding = 4 2
execp_background_id = 9
execp_centered = 1
execp_lclick_command = gnome-weather

#-------------------------------------
# Executor 9 — Date
#-------------------------------------
execp = new
execp_command = ~/.config/tint2/scripts/date.sh
execp_interval = 60
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = JetBrainsMono Nerd Font Mono 10
execp_font_color = #ffffff 100
execp_padding = 4 2
execp_background_id = 10
execp_centered = 1
execp_lclick_command = orage
