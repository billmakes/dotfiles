# tint2rc — single full-width bar per monitor.
# Workspaces left, status modules right.
# execp_monitor 1 = HDMI-A-0 (left), execp_monitor 2 = DisplayPort-2 (right).

#-------------------------------------
# Backgrounds
#-------------------------------------

# 1: transparent
rounded = 0
border_width = 0
border_color = #000000 0
background_color = #000000 0

# 2: panel
rounded = 0
border_width = 0
border_color = #000000 0
background_color = #000000 100

# 3: snapshot
rounded = 0
border_width = 2
border_sides = TL
border_color = #bd3232 100
background_color = #8b0000 100

# 4: spotify
rounded = 0
border_width = 2
border_sides = TL
border_color = #4e5a65 100
background_color = #1c2833 100

# 5: disk
rounded = 0
border_width = 2
border_sides = TL
border_color = #aa7444 100
background_color = #784212 100

# 6: cpu
rounded = 0
border_width = 2
border_sides = TL
border_color = #4c55b0 100
background_color = #1a237e 100

# 7: memory
rounded = 0
border_width = 2
border_sides = TL
border_color = #7c558c 100
background_color = #4a235a 100

# 8: volume
rounded = 0
border_width = 2
border_sides = TL
border_color = #3232dc 100
background_color = #0000aa 100

# 9: weather
rounded = 0
border_width = 2
border_sides = TL
border_color = #4d9052 100
background_color = #1b5e20 100

# 10: date
rounded = 0
border_width = 2
border_sides = TL
border_color = #ad6a32 100
background_color = #7b3800 100

# 11: time/clock
rounded = 0
border_width = 2
border_sides = TL
border_color = #329296 100
background_color = #006064 100

# 12: systray
rounded = 0
border_width = 2
border_sides = TL
border_color = #555555 100
background_color = #222222 100

# 13: disk-storage
rounded = 0
border_width = 2
border_sides = TL
border_color = #546e7a 100
background_color = #37474f 100

#-------------------------------------
# Panel
#-------------------------------------
panel_items = E1E2E3E4E5E6E7E8E9E10FE11E12E13E14E15E16E17E18E19CS
panel_size = 100% 24
panel_margin = 0 0
panel_padding = 0 2 2
panel_dock = 0
panel_layer = bottom
panel_position = bottom left horizontal
panel_monitor = all
wm_menu = 0
panel_background_id = 2
panel_shrink = 0

#-------------------------------------
# System Tray
#-------------------------------------
systray_padding = 6 2 4
systray_background_id = 12
systray_sort = ascending
systray_icon_size = 16
systray_icon_asb = 100 0 0
systray_monitor = primary

#-------------------------------------
# Clock
#-------------------------------------
time1_format = %I:%M %p
time1_font = JetBrainsMono Nerd Font Mono 10
time2_format =
clock_font_color = #ffffff 100
clock_padding = 6 2
clock_background_id = 11
clock_lclick_command =
clock_rclick_command =

#-------------------------------------
# E1-E5: L workspaces (execp_monitor = 1 = HDMI-A-0)
