/*
 * Chicago95-style rofi theme.
 * Palette copied from ~/clones/Chicago95/Theme/Chicago95/gtk-3.0/gtk.css.
 */

* {
  bg-color: #c0c0c0;
  fg-color: #000000;
  base-color: #ffffff;
  text-color: #000000;
  selected-bg-color: #000080;
  selected-fg-color: #ffffff;
  inactive-title-bg-color: #808080;
  inactive-title-fg-color: #c0c0c0;
  border-bright: #ffffff;
  border-light: #dfdfdf;
  border-shade: #808080;
  border-dark: #000000;
  disabled-fg-color: #808080;
  tooltip-bg-color: #ffffe1;
  warning-bg-color: #ffedcc;
  error-bg-color: #ffcccc;

  background-color: transparent;
  text-color: @fg-color;
  font: "Liberation Sans 9";
}

window {
  background-color: @bg-color;
  text-color: @fg-color;
  border: 2px;
  border-color: @border-dark;
  border-radius: 0;
  padding: 2px;
}

mainbox {
  background-color: @bg-color;
  border: 2px;
  border-color: @border-bright;
  spacing: 0;
}

inputbar {
  background-color: @selected-bg-color;
  text-color: @selected-fg-color;
  border: 2px;
  border-color: @border-dark;
  padding: 3px 4px;
  spacing: 6px;
}

prompt {
  background-color: @selected-bg-color;
  text-color: @selected-fg-color;
  padding: 1px 4px;
}

entry {
  background-color: @base-color;
  text-color: @text-color;
  placeholder-color: @disabled-fg-color;
  border: 2px;
  border-color: @border-shade;
  padding: 3px 5px;
}

case-indicator {
  background-color: @selected-bg-color;
  text-color: @selected-fg-color;
}

listview {
  background-color: @bg-color;
  text-color: @fg-color;
  border: 2px;
  border-color: @border-shade;
  padding: 2px;
}

element {
  background-color: @bg-color;
  text-color: @fg-color;
  border: 1px;
  border-color: @bg-color;
}

element normal.normal,
element alternate.normal {
  background-color: @bg-color;
  text-color: @fg-color;
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: @selected-bg-color;
  text-color: @selected-fg-color;
  border-color: @selected-bg-color;
}

element active.normal {
  background-color: @base-color;
  text-color: @text-color;
  border-color: @border-dark;
}

element urgent.normal {
  background-color: @warning-bg-color;
  text-color: @fg-color;
  border-color: @border-dark;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

scrollbar {
  background-color: @base-color;
  handle-color: @bg-color;
  border: 2px;
  border-color: @border-shade;
}

message {
  background-color: @tooltip-bg-color;
  text-color: @fg-color;
  border: 2px;
  border-color: @border-dark;
  padding: 4px;
}

textbox {
  background-color: transparent;
  text-color: @fg-color;
}

error-message {
  background-color: @error-bg-color;
  text-color: @fg-color;
  border: 2px;
  border-color: @border-dark;
  padding: 8px;
}
