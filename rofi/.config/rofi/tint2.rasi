/*
 * Dark theme mirroring the tint2 panel palette.
 * Panel bg #0f0d0d, teal accent #329296/#006064, task-normal #1e1e1e.
 */

* {
  bg-color:           #0f0d0d;
  base-color:         #1e1e1e;
  fg-color:           #bbbbbb;
  text-color:         #ffffff;
  accent-color:       #4e5a65;
  selected-bg-color:  @accent-color;
  selected-fg-color:  #ffffff;
  border-color:       #444444;
  bevel-light-color:  #4e5a65;
  bevel-dark-color:   #10181e;
  selected-bevel-light-color: #7a838b;
  selected-bevel-dark-color:  #151e26;
  inactive-fg-color:  #888888;
  urgent-bg-color:    #3d0000;
  urgent-border-color: #bd3232;

  background-color: transparent;
  text-color: @fg-color;
  font: "Terminus 10";
}

window {
  background-color: @bg-color;
  text-color: @text-color;
  border: 2px 0 0 2px;
  border-color: @bevel-light-color;
  border-radius: 1px;
  padding: 0;
  orientation: vertical;
  children: [ bevel-middle, bevel-bottom ];
}

bevel-middle {
  background-color: @bevel-dark-color;
  orientation: horizontal;
  children: [ bevel-left, mainbox, bevel-right ];
}

bevel-left {
  background-color: @bevel-light-color;
  expand: false;
  width: 2px;
}

bevel-right {
  background-color: @bevel-dark-color;
  expand: false;
  width: 2px;
}

bevel-bottom {
  background-color: @bevel-dark-color;
  expand: false;
  height: 2px;
}

mainbox {
  background-color: @bg-color;
  border: 0;
  spacing: 0;
}

inputbar {
  background-color: @bg-color;
  text-color: @text-color;
  border: 0 0 2px 0;
  border-color: @bevel-dark-color;
  padding: 3px 5px;
  spacing: 4px;
}

prompt {
  background-color: @accent-color;
  text-color: @selected-fg-color;
  border: 1px 0 0 2px;
  border-color: @selected-bevel-light-color;
  border-radius: 1px;
  padding: 2px 5px 1px 4px;
}

entry {
  background-color: @base-color;
  text-color: @text-color;
  placeholder-color: @inactive-fg-color;
  border: 1px 0 0 2px;
  border-color: @bevel-dark-color;
  border-radius: 1px;
  padding: 2px 5px;
}

case-indicator {
  background-color: @base-color;
  text-color: @inactive-fg-color;
  border: 1px 0 0 2px;
  border-color: @bevel-dark-color;
  border-radius: 1px;
  padding: 2px 4px;
}

listview {
  background-color: @bg-color;
  text-color: @fg-color;
  border: 2px 0 0 0;
  border-color: @bevel-dark-color;
  padding: 2px;
}

element {
  background-color: @bg-color;
  text-color: @fg-color;
  border: 0;
  padding: 3px 6px;
}

element normal.normal,
element alternate.normal {
  background-color: @bg-color;
  text-color: @fg-color;
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: @selected-bg-color;
  text-color: @selected-fg-color;
  border: 1px 0 0 2px;
  border-color: @selected-bevel-light-color;
  border-radius: 1px;
  padding: 2px 6px 1px 5px;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text,
element selected.normal element-icon,
element selected.active element-icon,
element selected.urgent element-icon {
  background-color: transparent;
  text-color: @selected-fg-color;
  border: 0 0 2px 0;
  border-color: @selected-bevel-dark-color;
}

element normal.active,
element alternate.active {
  background-color: @base-color;
  text-color: @text-color;
}

element normal.urgent,
element alternate.urgent {
  background-color: @urgent-bg-color;
  text-color: @text-color;
  border: 0 0 0 2px;
  border-color: @urgent-border-color;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

scrollbar {
  background-color: @base-color;
  handle-color: @border-color;
  border: 0;
}

message {
  background-color: @base-color;
  text-color: @fg-color;
  border: 2px;
  border-color: @bevel-light-color;
  border-radius: 1px;
  padding: 4px;
}

textbox {
  background-color: transparent;
  text-color: @fg-color;
}

error-message {
  background-color: @urgent-bg-color;
  text-color: @text-color;
  border: 2px;
  border-color: @urgent-border-color;
  border-radius: 1px;
  padding: 8px;
}
