#!/bin/bash
# xfce4-panel GenMon workspace button for i3.
#
# One GenMon plugin instance per workspace.
# Command:  ~/.config/i3/scripts/genmon-workspace <WS_NAME>
# Period:   1 second
# Label:    off (disable the GenMon label field)
#
# Visual states match the tint2 workspace buttons:
#   focused  → blue   #285577
#   urgent   → red    #900000
#   visible  → grey   #5f676a  (on-screen but not focused)
#   inactive → dark   #222222
#   empty    → dim    #1a1a1a  (workspace not yet opened)

ws_name="$1"

ws=$(i3-msg -t get_workspaces 2>/dev/null \
    | jq -r --arg n "$ws_name" \
      '.[] | select(.name == $n) | "\(.focused) \(.urgent) \(.visible)"')

if [ -z "$ws" ]; then
    bg="#1a1a1a"; fg="#555555"; hi="#2a2a2a"
    state="empty"
else
    read -r focused urgent visible <<< "$ws"
    if   [ "$focused" = "true" ]; then
        bg="#285577"; fg="#ffffff"; hi="#4c7899"
        state="focused"
    elif [ "$urgent"  = "true" ]; then
        bg="#900000"; fg="#ffffff"; hi="#cc4444"
        state="urgent"
    elif [ "$visible" = "true" ]; then
        bg="#5f676a"; fg="#ffffff"; hi="#888888"
        state="visible"
    else
        bg="#222222"; fg="#888888"; hi="#444444"
        state="inactive"
    fi
fi

printf '<txt><span background="%s" foreground="%s"> %s </span></txt>\n' "$bg" "$fg" "$ws_name"
printf '<click>i3-msg workspace %s</click>\n' "$ws_name"
printf '<tool>%s [%s]</tool>\n' "$ws_name" "$state"
