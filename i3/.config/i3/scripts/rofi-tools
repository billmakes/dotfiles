#!/bin/bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

tools=(
  'Wallpapers|rofi-wallpaper'
  'Clipboard|greenclip print'
  'Screen Temperature|rofi-redshift'
  'Notifications|rofi-dunst-history'
)

escape_markup() {
  sed \
    -e 's/&/\&amp;/g' \
    -e 's/</\&lt;/g' \
    -e 's/>/\&gt;/g'
}

entries=''
for index in "${!tools[@]}"; do
  tool="${tools[$index]}"
  number="$((index + 1))"
  title="${tool%%|*}"
  subtitle="${tool##*|}"
  escaped_title="$(escape_markup <<<"$title")"
  escaped_subtitle="$(escape_markup <<<"$subtitle")"

  entries+="$number  <b>$escaped_title</b>"$'\n'
  entries+="   <small>$escaped_subtitle</small>"$'\003'
done

rofi_theme='
window {
  width: 500px;
  location: center;
  anchor: center;
  border: 1px;
  border-radius: 0;
  padding: 0;
}

mainbox {
  spacing: 0;
}

inputbar {
  padding: 10px 12px;
  spacing: 10px;
  border: 0 0 1px 0;
  children: [ prompt, entry ];
}

prompt {
  font: "Monospace Bold 10";
}

entry {
  placeholder: "type an index or filter tools";
}

listview {
  lines: 4;
  columns: 1;
  fixed-height: true;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  spacing: 2px;
  padding: 6px;
}

element {
  padding: 5px 8px;
  border-radius: 4px;
}

element-text {
  text-color: inherit;
  vertical-align: 0.5;
}
'

selection_index=$(
  rofi -dmenu -i -p 'Tools' \
    -markup-rows \
    -sep $'\003' \
    -eh 2 \
    -no-custom \
    -format i \
    -theme-str "$rofi_theme" <<<"$entries"
)

[ -z "${selection_index:-}" ] && exit 0

case "$selection_index" in
  0) "$script_dir/rofi-wallpaper" ;;
  1) rofi -modi 'clipboard:greenclip print' -show clipboard -run-command '{cmd}' ;;
  2) "$script_dir/rofi-redshift" ;;
  3) "$script_dir/rofi-dunst-history" ;;
  *) exit 1 ;;
esac
