#!/bin/bash
set -euo pipefail

WALL_DIR="$HOME/walls"

escape_markup() {
  sed \
    -e 's/&/\&amp;/g' \
    -e 's/</\&lt;/g' \
    -e 's/>/\&gt;/g'
}

mapfile -t wallpapers < <(
  find "$WALL_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) |
  sort
)

[ "${#wallpapers[@]}" -eq 0 ] && {
  rofi -e "No wallpapers found in $WALL_DIR"
  exit 1
}

print_entries() {
  printf 'Random\t<small><i>(Pick a random wallpaper)</i></small>\003'

  for index in "${!wallpapers[@]}"; do
    file="${wallpapers[$index]}"
    number="$((index + 1))"
    filename="$(basename "$file")"
    title="${filename%.*}"
    title="${title//_/ }"
    title="${title//-/ }"
    escaped_title="$(escape_markup <<<"$title")"
    escaped_filename="$(escape_markup <<<"$filename")"

    printf '%s  <b>%s</b>\t<small><i>(%s)</i></small>\0icon\x1f%s\003' \
      "$number" "$escaped_title" "$escaped_filename" "$file"
  done
}

rofi_theme='
window {
  width: 760px;
  location: center;
  anchor: center;
}

entry {
  placeholder: "type an index or filter wallpapers";
}

listview {
  lines: 6;
  columns: 1;
  fixed-height: true;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  spacing: 0;
  padding: 2px;
}

element {
  spacing: 8px;
}

element-icon {
  size: 18px;
}

element-text {
  vertical-align: 0.5;
}
'

selection_index=$(
  print_entries |
  rofi -dmenu -i -show-icons -p 'Wallpaper' \
    -markup-rows \
    -sep $'\003' \
    -eh 1 \
    -no-custom \
    -format i \
    -theme-str "$rofi_theme"
)

[ -z "${selection_index:-}" ] && exit 0

if [ "$selection_index" -eq 0 ]; then
  wallpaper="${wallpapers[$((RANDOM % ${#wallpapers[@]}))]}"
else
  wallpaper="${wallpapers[$((selection_index - 1))]}"
fi

feh --bg-fill "$wallpaper"
notify-send "Wallpaper set" "$(basename "$wallpaper")"
