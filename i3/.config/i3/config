# i3 configuration migrated from ~/.config/sway/config.
# Wayland-only commands have been replaced with X11 equivalents where needed.

### Core
set $mod Mod4
set $term alacritty
set $menu rofi -show drun
set $scripts ~/.config/i3/scripts

font pango:monospace 8

### Displays
# Keep output names here so workspace placement and xrandr stay in sync.
set $mon_left DisplayPort-2
set $mon_right DisplayPort-1

# Left monitor: primary 120 Hz. Right monitor: 239.76 Hz.
# exec_always --no-startup-id xrandr --output $mon_left --primary --mode 1920x1080 --rate 120 --pos 0x0 --output $mon_right --mode 1920x1080 --rate 239.76 --pos 1920x0
exec_always --no-startup-id xrandr --output "DisplayPort-2" --primary --mode 1920x1080 --rate 120 --pos 0x0 --output "DisplayPort-1" --mode 1920x1080 --rate 239.76 --pos 1920x0
exec_always --no-startup-id sh -c '[ -x ~/.fehbg ] && ~/.fehbg'
### Session
# Export the X11/i3 environment for dbus/systemd-launched services.
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3 XDG_SESSION_DESKTOP=i3 XDG_SESSION_TYPE=x11

### Pointer and Window Defaults
focus_follows_mouse yes
mouse_warping none
floating_modifier $mod
tiling_drag modifier titlebar

# Small XFCE utilities are easier to use as floating windows.
for_window [class="^[Tt]hunar$"] floating enable
for_window [class="^[Gg]alculator$"] floating enable
for_window [class="^[Oo]rage$"] floating enable
for_window [class="^[Gg]ucharmap$"] floating enable
for_window [class="^[Xx]fce4-taskmanager$"] floating enable
for_window [class="^[Xx]fce4-screenshooter$"] floating enable

# Xfdesktop
# for_window [class="Xfdesktop"] floating enable, border none, sticky enable

for_window [class="Docker"] floating enable, border none
for_window [class="wmclock"] floating enable, border none
for_window [class="^[Ww]Mclock$"] floating enable, border none, sticky enable
for_window [class="WMClock"] floating enable, border none, sticky enable

# Conky widget
for_window [class="ConkyTint2Widget"] floating enable, border none, sticky enable
no_focus [class="ConkyTint2Widget"]
for_window [class="ConkyI3Workspaces"] floating enable, border none, sticky enable
no_focus [class="ConkyI3Workspaces"]
for_window [class="Wm.*"] floating enable, sticky enable, border none
for_window [class="wm.*"] floating enable, sticky enable, border none

### Launchers and Session Actions
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+space exec --no-startup-id xfce4-popup-whiskermenu
# bindsym $mod+space exec --no-startup-id $menu
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+w exec --no-startup-id $scripts/rofi-windows
bindsym $mod+g exec --no-startup-id $scripts/rofi-xfce-tools
bindsym $mod+s exec --no-startup-id $scripts/rofi-tools
bindsym $mod+x exec --no-startup-id $scripts/rofi-system

bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

### Focus and Movement
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Tab focus output right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


bindsym $mod+l focus right
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+h focus left

bindsym $mod+Shift+l move right
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+h move left

### Workspaces
# L* workspaces live on the left monitor; R* workspaces live on the right.
# The ws/mvws helper scripts choose L or R from the currently focused output.
set $wsL1 "L1"
set $wsL2 "L2"
set $wsL3 "L3"
set $wsL4 "L4"
set $wsL5 "L5"

set $wsR1 "R1"
set $wsR2 "R2"
set $wsR3 "R3"
set $wsR4 "R4"
set $wsR5 "R5"

workspace $wsL1 output $mon_left
workspace $wsL2 output $mon_left
workspace $wsL3 output $mon_left
workspace $wsL4 output $mon_left
workspace $wsL5 output $mon_left

workspace $wsR1 output $mon_right
workspace $wsR2 output $mon_right
workspace $wsR3 output $mon_right
workspace $wsR4 output $mon_right
workspace $wsR5 output $mon_right

bindsym $mod+1 exec --no-startup-id $scripts/ws 1
bindsym $mod+2 exec --no-startup-id $scripts/ws 2
bindsym $mod+3 exec --no-startup-id $scripts/ws 3
bindsym $mod+4 exec --no-startup-id $scripts/ws 4
bindsym $mod+5 exec --no-startup-id $scripts/ws 5

bindsym $mod+Shift+1 exec --no-startup-id $scripts/mvws 1
bindsym $mod+Shift+2 exec --no-startup-id $scripts/mvws 2
bindsym $mod+Shift+3 exec --no-startup-id $scripts/mvws 3
bindsym $mod+Shift+4 exec --no-startup-id $scripts/mvws 4
bindsym $mod+Shift+5 exec --no-startup-id $scripts/mvws 5

### Layout
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle
# bindsym $mod+h split h
bindsym $mod+v split v

gaps outer 2
gaps inner 7

### Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Resize Mode
mode "resize" {
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Up resize grow height 10 px or 10 ppt
    bindsym Down resize shrink height 10 px or 10 ppt

    bindsym j resize grow width 10 px or 10 ppt
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### Media and Utilities
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+

bindsym $mod+b exec --no-startup-id librewolf
bindsym $mod+n exec --no-startup-id $scripts/grayscale

# X11 screenshot replacement for grim/slurp/wl-copy.
bindsym Print exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'

