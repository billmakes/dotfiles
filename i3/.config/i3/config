# i3 config migrated from ~/.config/sway/config.
# X11 equivalents are used where Sway/Wayland commands do not apply.

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu rofi -show drun

font pango:monospace 8

### Session environment
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3 XDG_SESSION_DESKTOP=i3 XDG_SESSION_TYPE=x11
exec --no-startup-id dex --autostart --environment i3
# exec --no-startup-id nm-applet

### Display configuration
exec_always --no-startup-id xrandr --output HDMI-1 --mode 1920x1080 --rate 120 --pos 0x0 --output DP-3 --primary --mode 1920x1080 --rate 239.76 --pos 1920x0
exec_always --no-startup-id sh -c '[ -x ~/.fehbg ] && ~/.fehbg'

### Pointer behavior
focus_follows_mouse no
mouse_warping none
floating_modifier $mod
tiling_drag modifier titlebar

### Basics
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+q kill
bindsym $mod+space exec --no-startup-id $menu
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+w exec --no-startup-id rofi -show window
bindsym $mod+b exec --no-startup-id ~/bin/grayscale

bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

### Moving around
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces
set $wsL1 "L1"
set $wsL2 "L2"
set $wsL3 "L3"
set $wsL4 "L4"
set $wsL5 "L5"

set $wsR1 "R1"
set $wsR2 "R2"
set $wsR3 "R3"
set $wsR4 "R4"
set $wsR5 "R5"

workspace $wsL1 output HDMI-1
workspace $wsL2 output HDMI-1
workspace $wsL3 output HDMI-1
workspace $wsL4 output HDMI-1
workspace $wsL5 output HDMI-1

workspace $wsR1 output DP-3
workspace $wsR2 output DP-3
workspace $wsR3 output DP-3
workspace $wsR4 output DP-3
workspace $wsR5 output DP-3

bindsym $mod+1 exec --no-startup-id ~/bin/ws 1
bindsym $mod+2 exec --no-startup-id ~/bin/ws 2
bindsym $mod+3 exec --no-startup-id ~/bin/ws 3
bindsym $mod+4 exec --no-startup-id ~/bin/ws 4
bindsym $mod+5 exec --no-startup-id ~/bin/ws 5

bindsym $mod+Shift+1 exec --no-startup-id ~/bin/mvws 1
bindsym $mod+Shift+2 exec --no-startup-id ~/bin/mvws 2
bindsym $mod+Shift+3 exec --no-startup-id ~/bin/mvws 3
bindsym $mod+Shift+4 exec --no-startup-id ~/bin/mvws 4
bindsym $mod+Shift+5 exec --no-startup-id ~/bin/mvws 5

bindsym $mod+Tab focus output right

### Layout
#bindsym $mod+s layout stacking
#bindsym $mod+Shift+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle
