### Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Resize mode
mode "resize" {
    bindsym Left resize grow width 10 px or 10 ppt
    bindsym Right resize shrink width 10 px or 10 ppt
    bindsym Up resize grow height 10 px or 10 ppt
    bindsym Down resize shrink height 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

set $rofi_tools "rofi tools: w=wallpapers c=clipboard t=screen temp n=notifs" 

mode $rofi_tools {
	bindsym w exec --no-startup-id ~/bin/rofi-wallpaper, mode "default"
	bindsym c exec rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}', mode "default"
	bindsym t exec --no-startup-id ~/bin/rofi-redshift, mode "default"
	bindsym n exec --no-startup-id ~/bin/rofi-dunst-history, mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+s mode $rofi_tools

# bindsym Escape mode "default"

### Utilities
set $refresh_i3blocks pkill -RTMIN+10 i3blocks
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3blocks
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3blocks
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3blocks
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+

# X11 screenshot replacement for grim/slurp/wl-copy.
bindsym Print exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'

set $system_opts "system: l=lock r=restart c=reload e=exit i3"

mode $system_opts {
    bindsym l exec slock, mode "default"
    bindsym r restart, mode "default"
    bindsym c reload, mode "default"
    bindsym e exec --no-startup-id "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' - 'Yes, exit i3' 'i3-msg exit'"

    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+x mode $system_opts

exec --no-startup-id sh -c 'xset s 300 300; xset dpms 600 600 600'

### Clipboard
# The Sway config uses wl-paste/wl-copy/cliphist, which are Wayland-specific.
# No X11 rofi clipboard backend such as clipmenu or greenclip is currently installed.


bar {
    status_command i3blocks
}
