#!/bin/bash
set -e

DOTFILES="$(cd "$(dirname "$0")" && pwd)"

packages=(
  i3
  i3status
  fish
  alacritty
  foot
  tmux
)

for package in "${packages[@]}"; do
  if [ ! -d "$DOTFILES/$package" ]; then
    echo "Skipping $package: $DOTFILES/$package does not exist"
    continue
  fi

  echo "Stowing $package"
  stow --dir "$DOTFILES" --target "$HOME" --restow "$package"
done

echo "Dotfiles stowed into $HOME"
